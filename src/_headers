/assets/*
  cache-control: public, max-age=31536000, s-maxage=31536000, immutable

/livecodes/*
  cache-control: public, max-age=31536000, s-maxage=31536000, immutable

/livecodes/:file.map
  ! cache-control
  cache-control: public, max-age=14400, must-revalidate

/livecodes/assets/*
  ! cache-control
  cache-control: public, max-age=14400, must-revalidate

# Font files never change in place (renamed if they do); must come after the rule above to win.
# One rule per file so fonts.css (a stylesheet) keeps the 4 h rule.
/livecodes/assets/fonts/Fraunces-Italic-Variable.woff2
  ! cache-control
  cache-control: public, max-age=2592000

/livecodes/assets/fonts/Fraunces-Variable.woff2
  ! cache-control
  cache-control: public, max-age=2592000

/livecodes/assets/fonts/JetBrainsMono-Italic-Variable.woff2
  ! cache-control
  cache-control: public, max-age=2592000

/livecodes/assets/fonts/JetBrainsMono-Variable.woff2
  ! cache-control
  cache-control: public, max-age=2592000

/livecodes/assets/fonts/Sen-Variable.woff2
  ! cache-control
  cache-control: public, max-age=2592000

# Cloudflare Web Analytics injects a module beacon into HTML responses. In the
# /app iframe shell that makes Firefox ignore the app's import map (breaks CodeMirror).
/app
  ! cache-control
  cache-control: public, max-age=0, must-revalidate, no-transform
