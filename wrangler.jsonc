{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hellowattson-playground",
  "account_id": "c79b013d5dffa41db3bcc4e826a24ad7",
  "compatibility_date": "2026-05-20",
  "workers_dev": true,
  // Custom domain decided 2026-09-20 (hello-wattson#66); the workers.dev URL
  // stays live so existing lesson links keep working.
  "routes": [
    { "pattern": "play.hellowattson.ca", "custom_domain": true }
  ],
  "assets": {
    "directory": "build"
  },
  "env": {
    // Bindings are not inherited by environments: repeat every binding added at the top level here.
    // Staging has no custom domain; host is the workers.dev URL.
    "staging": {
      "name": "hellowattson-playground-staging",
      "workers_dev": true,
      "routes": [],
      "assets": {
        "directory": "build"
      }
    }
  }
}